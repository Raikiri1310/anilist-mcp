# Copy this file to .env and fill in the values

# AniList API Token (Only needed for operations requiring authentication)
# Follow the steps in the README file to get one
ANILIST_TOKEN=your_api_token

# Use TRANSPORT=http for Streamable HTTP transport mode
# TRANSPORT=http

# Port for the Streamable HTTP server
# PORT=8081

# Configure CORS origin appropriately for production Streamable HTTP server (split multiple origins with commas)
# CORS_ORIGIN=https://your-remote-domain.com,https://your-other-remote-domain.com

# Restrict which Host/Origin headers the Streamable HTTP server accepts.
# Setting either one turns on DNS-rebinding protection; leaving both unset
# keeps the previous (unvalidated) behaviour. Recommended whenever the server
# is bound locally with ANILIST_TOKEN set, so a web page the user visits
# cannot drive the server as your AniList account.
# ALLOWED_HOSTS=127.0.0.1:8081,localhost:8081
# ALLOWED_ORIGINS=https://your-remote-domain.com
